# ──────────────────────────────────────────────
# CloudCanvas – Environment Variables
# ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env

# ── REQUIRED ──────────────────────────────────
# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-api-key-here

# ── OPTIONAL ──────────────────────────────────
# Gemma model variant: gemma-4-12b-it (default) or gemma-4-4b-it
# GEMMA_MODEL=gemma-4-12b-it

# Default cloud provider: AWS (default), GCP, or Azure
# DEFAULT_CLOUD_PROVIDER=AWS

# Max upload size in MB (default: 10)
# MAX_UPLOAD_SIZE_MB=10

# CORS origins (comma-separated)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Debug mode
# DEBUG=false

# ── SUPABASE ──────────────────────────────────
# Supabase project URL and anon key
# SUPABASE_URL=https://xqwtoxvirhnmrzlehetr.supabase.co
# SUPABASE_KEY=your-supabase-anon-key
